{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "P2 Seasonal index: average month in each season vs the average month (complete seasons only). Field-well names (rename for this visual): Season, Season Sort, Index, Avg Monthly",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "transform": [
    {
      "filter": "isValid(datum['Index'])"
    },
    {
      "calculate": "datum['Index'] >= 1.03 ? '#D56B63' : (datum['Index'] <= 0.97 ? '#168A86' : '#A9B4C2')",
      "as": "Col"
    },
    {
      "calculate": "format(datum['Index'], '.2f') + '  (' + format(datum['Avg Monthly'], ',.0f') + ' / month)'",
      "as": "Label"
    },
    {
      "calculate": "(datum['Index'] >= 1 ? '+' : '') + format((datum['Index'] - 1) * 100, '.0f') + '% vs average month'",
      "as": "Diff"
    }
  ],
  "encoding": {
    "y": {
      "field": "Season",
      "type": "nominal",
      "sort": {
        "field": "Season Sort",
        "order": "ascending"
      },
      "scale": {
        "paddingInner": 0.35
      },
      "axis": {
        "title": null,
        "labelColor": "#14263D",
        "labelFontSize": 10,
        "labelFont": "Segoe UI Semibold",
        "domain": false,
        "ticks": false,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "Index",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.85,
              1.15
            ],
            "nice": false,
            "zero": false,
            "clamp": true
          },
          "axis": {
            "title": "1.00 = average month",
            "titleColor": "#536579",
            "titleFontWeight": "normal",
            "titleFontSize": 9,
            "values": [
              0.85,
              0.9,
              0.95,
              1,
              1.05,
              1.1,
              1.15
            ],
            "format": ".2f",
            "labelColor": "#536579",
            "labelFontSize": 8,
            "grid": false,
            "domain": false
          }
        },
        "x2": {
          "datum": 1
        },
        "color": {
          "field": "Col",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "tooltip": [
          {
            "field": "Season",
            "title": "Season"
          },
          {
            "field": "Index",
            "title": "Seasonal index",
            "format": ".3f"
          },
          {
            "field": "Diff",
            "title": "Difference"
          },
          {
            "field": "Avg Monthly",
            "title": "Average crimes per month",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "v": 1
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#536579",
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "v",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum['Index'] >= 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 9,
        "color": "#14263D"
      },
      "encoding": {
        "x": {
          "field": "Index",
          "type": "quantitative"
        },
        "text": {
          "field": "Label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum['Index'] < 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 9,
        "color": "#14263D"
      },
      "encoding": {
        "x": {
          "datum": 1.005
        },
        "text": {
          "field": "Label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI"
  }
}