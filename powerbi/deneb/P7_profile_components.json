{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "P7 Component profile: one bar per component. One LSOA in focus = its scores; several LSOAs (no LSOA chosen) = their average. Safety Index components navy, family suitability components teal; 0-100, 100 = best in South Yorkshire, amber line = 50. Field-well names (rename for this visual): Code, LSOA, Severity, Crime rate, ASB, Trend, Schools, Family, Environment, Affordability",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "transform": [
    {
      "fold": [
        "Severity",
        "Crime rate",
        "ASB",
        "Trend",
        "Schools",
        "Family",
        "Environment",
        "Affordability"
      ],
      "as": [
        "Key",
        "Score"
      ]
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "Score",
          "as": "Score"
        },
        {
          "op": "distinct",
          "field": "Code",
          "as": "N"
        },
        {
          "op": "max",
          "field": "LSOA",
          "as": "LSOA"
        }
      ],
      "groupby": [
        "Key"
      ]
    },
    {
      "calculate": "indexof([\"Severity\", \"Crime rate\", \"ASB\", \"Trend\", \"Schools\", \"Family\", \"Environment\", \"Affordability\"], datum['Key'])",
      "as": "Order"
    },
    {
      "calculate": "datum['Order'] < 4 ? 'Safety Index' : 'Family suitability'",
      "as": "Group"
    },
    {
      "calculate": "{\"Severity\": \"Harm (severity)\", \"Crime rate\": \"Crime rate\", \"ASB\": \"Anti-social behaviour\", \"Trend\": \"Trend\", \"Schools\": \"Schools\", \"Family\": \"Family community\", \"Environment\": \"Environment\", \"Affordability\": \"Affordability (your budget)\"}[datum['Key']]",
      "as": "Component"
    },
    {
      "calculate": "datum['N'] === 1 ? datum['LSOA'] : 'average of ' + format(datum['N'], ',') + ' LSOAs'",
      "as": "Scope"
    },
    {
      "calculate": "isValid(datum['Score']) ? format(datum['Score'], '.0f') : (datum['Key'] === 'Affordability' ? 'over budget' : 'n/a')",
      "as": "Label"
    },
    {
      "calculate": "isValid(datum['Score']) ? datum['Score'] : 0",
      "as": "Bar"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.62
        },
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "x": {
          "field": "Bar",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "nice": false
          },
          "axis": {
            "title": null,
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelColor": "#536579",
            "labelFontSize": 8.5,
            "gridColor": "#E3E8EF",
            "domain": false,
            "ticks": false
          },
          "stack": null
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Safety Index",
              "Family suitability"
            ],
            "range": [
              "#14263D",
              "#168A86"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null,
            "labelColor": "#14263D",
            "labelFontSize": 8.5,
            "symbolType": "square",
            "symbolSize": 80
          }
        },
        "tooltip": [
          {
            "field": "Scope",
            "title": "Showing"
          },
          {
            "field": "Component",
            "title": "Component"
          },
          {
            "field": "Label",
            "title": "Score (100 = best in SY)"
          },
          {
            "field": "Group",
            "title": "Part of"
          }
        ],
        "y": {
          "field": "Component",
          "type": "nominal",
          "sort": [
            "Harm (severity)",
            "Crime rate",
            "Anti-social behaviour",
            "Trend",
            "Schools",
            "Family community",
            "Environment",
            "Affordability (your budget)"
          ],
          "axis": {
            "title": null,
            "labelColor": "#14263D",
            "labelFontSize": 9,
            "labelLimit": 170,
            "domain": false,
            "ticks": false,
            "labelPadding": 6
          }
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#E4A33B",
        "strokeDash": [
          3,
          3
        ],
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "datum": 50
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 8.5,
        "color": "#14263D"
      },
      "encoding": {
        "x": {
          "field": "Bar",
          "type": "quantitative",
          "stack": null
        },
        "text": {
          "field": "Label"
        },
        "y": {
          "field": "Component",
          "type": "nominal",
          "sort": [
            "Harm (severity)",
            "Crime rate",
            "Anti-social behaviour",
            "Trend",
            "Schools",
            "Family community",
            "Environment",
            "Affordability (your budget)"
          ]
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI"
  }
}